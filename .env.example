# Modelo de variáveis de ambiente. Configure-as no shell ou no painel do provedor.
# Este arquivo é apenas referência; o app não carrega .env automaticamente.
RASTRO_SECRET_KEY=replace-with-a-long-random-secret

# Sem DATABASE_URL, a aplicação usa SQLite local.
# Exemplo PostgreSQL:
# DATABASE_URL=postgresql://usuario:senha@host:1234/Rastro

# Opcional: habilita geração de metas com a API Anthropic.
# ANTHROPIC_API_KEY=
